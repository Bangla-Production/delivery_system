# ---- Browser (safe to expose) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Server only (Vercel -> Settings -> Environment Variables). NEVER put VITE_ in front of these. ----
# Firebase console -> Project settings -> Service accounts -> Generate new private key. Paste the JSON (or base64 of it).
FIREBASE_SERVICE_ACCOUNT=
# Cloudinary dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Meta WhatsApp Business Cloud API (see README step 1c)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: approved template with an IMAGE header + one {{1}} body variable. Used when the 24-hour window is closed.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
